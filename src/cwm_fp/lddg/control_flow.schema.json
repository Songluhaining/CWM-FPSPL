        "schema",
        "proof",
        "proof_sha256",
        "assessment"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "normal_path_v1"
        },
        "proof_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proof": {
          "type": "object",
          "required": [
            "methods",
            "events",
            "execution_complete_and_consistent",
            "test_outcome",
            "trace_sha256",
            "failure_types"
          ],
          "properties": {
            "methods": {
              "type": "array"
            },
            "events": {
              "type": "array"
            },
            "execution_complete_and_consistent": {
              "type": "boolean"
            },
            "test_outcome": {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN"
              ]
            },
            "trace_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "failure_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "assessment": {
          "type": "object",
          "required": [
            "accepted",
            "classification",
            "scope",
            "exception_control_supported",
            "errors",
            "normal_transitions",
            "handler_visits",
            "certified_exception_transitions"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "scope": {
              "const": "normal-path-only"
            },
            "exception_control_supported": {
              "const": false
            },
            "certified_exception_transitions": {
              "const": 0
            },
            "errors": {
              "type": "array"
            },
            "normal_transitions": {
              "type": "array"
            },
            "handler_visits": {
              "type": "array"
            }
          }
        }
      }
    },
